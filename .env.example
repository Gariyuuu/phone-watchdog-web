# Set in Vercel project settings (Environment Variables), not committed.

# Shared password for the site's Basic Auth gate (src/proxy.ts).
SITE_PASSWORD=

# Auto-populated when you provision Vercel Postgres/Neon and connect it
# to this project. Leave unset locally to run without a database —
# webcam detection and the alarm still work, just without a saved log.
POSTGRES_URL=
